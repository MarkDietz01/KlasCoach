<%- include('partials/header') %>
<div class="container-fluid board-container" data-class-id="<%= selectedClassId %>">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
      <h1 class="display-4 fw-bold">KlassenCoach</h1>
      <p class="text-muted mb-0">Klas: <%= (classes.find(c => c.id === selectedClassId) || {}).name || '' %></p>
    </div>
    <form class="d-flex align-items-center gap-2" method="POST" action="/class/select">
      <label class="fw-semibold">Kies klas:</label>
      <select name="class_id" class="form-select form-select-lg">
        <% classes.forEach(cls => { %>
          <option value="<%= cls.id %>" <%= cls.id === selectedClassId ? 'selected' : '' %>><%= cls.name %></option>
        <% }) %>
      </select>
      <button class="btn btn-primary btn-lg" type="submit">Toon</button>
    </form>
  </div>
  <div class="traffic-wrapper">
    <div class="traffic-light">
      <div class="traffic-light-inner" data-state="<%= traffic.state %>">
        <span id="traffic-label"></span>
      </div>
    </div>
    <p class="lead text-muted">Realtime stoplicht voor de klas</p>
    <div class="timer-display mt-3" data-ends-at="<%= timer.ends_at ? new Date(timer.ends_at).toISOString() : '' %>" data-label="<%= timer.label || '' %>">
      <div class="timer-label h4 mb-1"><%= timer.label || 'Timer' %></div>
      <div class="timer-countdown display-5 fw-bold">--:--</div>
    </div>
  </div>
  <div class="student-grid">
    <% students.forEach(student => { %>
      <div class="student-card" data-student-id="<%= student.id %>">
        <div class="student-avatar">
          <% if (student.avatar_type === 'avataaars' && student.avatar_config) { %>
            <img src="https://avataaars.io/?<%= student.avatar_config %>" alt="avatar" />
          <% } else if (student.avatar_url) { %>
            <img src="<%= student.avatar_url %>" alt="avatar" />
          <% } else { %>
            <%= student.name.charAt(0) %>
          <% } %>
        </div>
        <div class="student-info">
          <p class="student-name"><%= student.name %></p>
          <p class="student-group"><%= student.group_name || '' %></p>
        </div>
        <div class="student-points"><%= student.total_points %></div>
        <div class="point-change"></div>
      </div>
    <% }) %>
  </div>
</div>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/board.js"></script>
<%- include('partials/footer') %>
