<%- include('partials/header') %>
<nav class="navbar navbar-expand-lg navbar-light bg-light fixed-top shadow-sm">
  <div class="container-fluid">
    <a class="navbar-brand" href="/admin/students">KlassenCoach Admin</a>
    <div class="d-flex align-items-center gap-2">
      <form class="d-flex" method="POST" action="/class/select">
        <select name="class_id" class="form-select me-2">
          <% classes.forEach(cls => { %>
            <option value="<%= cls.id %>" <%= cls.id === selectedClassId ? 'selected' : '' %>><%= cls.name %></option>
          <% }) %>
        </select>
        <button class="btn btn-outline-primary" type="submit">Wissel</button>
      </form>
      <a class="btn btn-outline-secondary me-2" href="/admin/students">Leerlingen</a>
      <a class="btn btn-outline-secondary me-2" href="/admin/points">Punten</a>
      <a class="btn btn-outline-secondary me-2" href="/admin/traffic">Stoplicht</a>
      <a class="btn btn-outline-secondary me-2" href="/admin/reports">Rapportages</a>
      <a class="btn btn-danger" href="/admin/logout">Uitloggen</a>
    </div>
  </div>
</nav>
<div class="container admin-container">
  <div class="row">
    <div class="col-lg-4">
      <div class="admin-card">
        <div class="d-flex justify-content-between align-items-center">
          <h4 class="mb-3">Leerling toevoegen</h4>
          <span class="badge bg-info"><%= (classes.find(c => c.id === selectedClassId) || {}).name || '' %></span>
        </div>
        <div class="mb-3">
          <form class="d-flex" method="POST" action="/admin/classes/add">
            <input type="text" name="name" class="form-control me-2" placeholder="Nieuwe klasnaam">
            <button class="btn btn-secondary" type="submit">Klas aanmaken</button>
          </form>
        </div>
        <form method="POST" action="/admin/students/add">
          <input type="hidden" name="class_id" value="<%= selectedClassId %>">
          <div class="mb-3">
            <label class="form-label">Naam</label>
            <input type="text" name="name" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Groep/tafel</label>
            <input type="text" name="group_name" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Avatar modus</label><br>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="avatar_mode" id="avatarUrl" value="url" checked>
              <label class="form-check-label" for="avatarUrl">URL</label>
            </div>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="avatar_mode" id="avatarAvataaars" value="avataaars">
              <label class="form-check-label" for="avatarAvataaars">Avataaars</label>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Avatar URL</label>
            <input type="url" name="avatar_url" class="form-control" placeholder="https://...">
          </div>
          <div class="mb-3">
            <label class="form-label">getAvataaars config</label>
            <input type="text" name="avatar_config" class="form-control" placeholder="kopieer alles achter het vraagteken">
            <small class="text-muted">Gebruik <a href="https://getavataaars.com" target="_blank">getavataaars.com</a> en kopieer alles achter het vraagteken.</small>
          </div>
          <button class="btn btn-primary w-100" type="submit">Opslaan</button>
        </form>
      </div>
    </div>
    <div class="col-lg-8">
      <div class="admin-card">
        <h4 class="mb-3">Leerlingen</h4>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Avatar</th>
                <th>Naam</th>
                <th>Groep</th>
                <th>Avatar-mode</th>
                <th>Acties</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach(student => { %>
                <tr>
                  <td>
                    <div class="table-avatar">
                      <% if (student.avatar_type === 'avataaars' && student.avatar_config) { %>
                        <img src="https://avataaars.io/?<%= student.avatar_config %>" alt="avatar" />
                      <% } else if (student.avatar_url) { %>
                        <img src="<%= student.avatar_url %>" alt="avatar" />
                      <% } else { %>
                        <%= student.name.charAt(0) %>
                      <% } %>
                    </div>
                  </td>
                  <td><%= student.name %></td>
                  <td><%= student.group_name || '' %></td>
                  <td><%= student.avatar_type %></td>
                  <td>
                    <form class="row g-2" method="POST" action="/admin/students/edit/<%= student.id %>">
                      <input type="hidden" name="class_id" value="<%= selectedClassId %>">
                      <div class="col-md-3">
                        <input type="text" class="form-control" name="name" value="<%= student.name %>" required>
                      </div>
                      <div class="col-md-2">
                        <input type="text" class="form-control" name="group_name" value="<%= student.group_name || '' %>">
                      </div>
                      <div class="col-md-2">
                        <select class="form-select" name="avatar_mode">
                          <option value="url" <%= student.avatar_type === 'url' ? 'selected' : '' %>>URL</option>
                          <option value="avataaars" <%= student.avatar_type === 'avataaars' ? 'selected' : '' %>>Character</option>
                        </select>
                      </div>
                      <div class="col-md-2">
                        <input type="text" class="form-control" name="avatar_url" value="<%= student.avatar_url || '' %>" placeholder="URL">
                      </div>
                      <div class="col-md-2">
                        <input type="text" class="form-control" name="avatar_config" value="<%= student.avatar_config || '' %>" placeholder="config">
                      </div>
                      <div class="col-md-1 d-grid">
                        <button class="btn btn-success btn-sm" type="submit">Opslaan</button>
                      </div>
                    </form>
                    <% if (student.is_active) { %>
                      <form method="POST" action="/admin/students/archive/<%= student.id %>" class="mt-1">
                        <button class="btn btn-outline-danger btn-sm">Archiveer</button>
                      </form>
                    <% } %>
                    <form method="POST" action="/admin/students/delete/<%= student.id %>" class="mt-1">
                      <button class="btn btn-outline-dark btn-sm">Verwijder</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/admin.js"></script>
<%- include('partials/footer') %>
