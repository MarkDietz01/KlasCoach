<%- include('partials/header') %>
<nav class="navbar navbar-expand-lg navbar-light bg-light fixed-top shadow-sm">
  <div class="container-fluid">
    <a class="navbar-brand" href="/admin/students">KlassenCoach Admin</a>
    <div class="d-flex">
      <a class="btn btn-outline-secondary me-2" href="/admin/students">Leerlingen</a>
      <a class="btn btn-outline-secondary me-2" href="/admin/points">Punten</a>
      <a class="btn btn-outline-secondary me-2" href="/admin/traffic">Stoplicht</a>
      <a class="btn btn-primary me-2" href="/admin/reports">Rapportages</a>
      <a class="btn btn-danger" href="/admin/logout">Uitloggen</a>
    </div>
  </div>
</nav>
<div class="container admin-container">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Rapportages</h3>
    <div>
      <a class="btn btn-outline-primary me-2" href="/admin/reports?period=day">Laatste dag</a>
      <a class="btn btn-outline-primary me-2" href="/admin/reports?period=week">Laatste week</a>
      <a class="btn btn-outline-primary me-2" href="/admin/reports?period=month">Laatste maand</a>
      <a class="btn btn-success" href="/admin/reports/export/csv?period=<%= period %>">Exporteer CSV</a>
    </div>
  </div>
  <p class="text-muted">Periode: <%= startStr %> t/m <%= endStr %></p>
  <div class="row g-4">
    <div class="col-lg-6">
      <div class="admin-card">
        <h5>Punten per leerling</h5>
        <div class="table-responsive">
          <table class="table table-sm">
            <thead><tr><th>Leerling</th><th>Groep</th><th>Totaal</th></tr></thead>
            <tbody>
              <% studentTotals.forEach(row => { %>
                <tr>
                  <td><%= row.name %></td>
                  <td><%= row.group_name || '' %></td>
                  <td><strong><%= row.total_points %></strong></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="admin-card">
        <h5>Tijdlijn per dag</h5>
        <div class="table-responsive">
          <table class="table table-sm">
            <thead><tr><th>Dag</th><th>Delta</th></tr></thead>
            <tbody>
              <% timeline.forEach(row => { %>
                <tr>
                  <td><%= row.day %></td>
                  <td><%= row.total %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="admin-card">
        <h5>Groepen</h5>
        <div class="table-responsive">
          <table class="table table-sm">
            <thead><tr><th>Groep</th><th>Totaal</th></tr></thead>
            <tbody>
              <% groupTotals.forEach(row => { %>
                <tr>
                  <td><%= row.group_name %></td>
                  <td><%= row.total_points %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="admin-card">
        <h5>Meest voorkomende redenen</h5>
        <div class="reason-cloud">
          <% reasons.forEach(row => { %>
            <span><%= row.reason %> (<%= row.count %>)</span>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
